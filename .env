# ─── Docker Compose Settings ────────────────────────────────────
# Copy this file to .env and fill in your values
# cp .env.example .env

# Port the app is accessible on (default: 80)
APP_PORT=80

# PostgreSQL credentials (used by docker-compose)
POSTGRES_USER=kbd_user
POSTGRES_PASSWORD=changeme_use_a_strong_password
POSTGRES_DB=kbd_school

# ─── FastAPI / Python ────────────────────────────────────────────
# Set automatically by docker-compose from the above values.
# For local dev (no Docker), override here:
# DATABASE_URL=sqlite:///./school.db

# For production on Neon (neon.tech — free tier):
# DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require
